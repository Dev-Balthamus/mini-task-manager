{
  "name": "backend",
  "version": "1.2.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec \"node --loader ts-node/esm\" src/server.ts",
    "m-create": "node-pg-migrate create -m migrations -j ts",
    "m-up": "node-pg-migrate up -m migrations --import ts-node/esm",
    "m-down": "node-pg-migrate down -m migrations --import ts-node/esm",
    "test": "npm run build && node --test --env-file=../.env tests/*.test.ts",
    "seed": "npm run build && node --env-file=../.env dist/repository/infrastructure/seed-mock-tasks.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "joi": "^18.2.1",
    "morgan": "^1.10.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
